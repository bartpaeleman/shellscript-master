#!/bin/bash

# Zorg dat autocomplete het scherm niet overvol maakt door het te wissen bij tab
set -o emacs
bind '"\t": "\C-l\e\e"' 2>/dev/null || true

# Master Wrapper Script for CYBER toolset

CYBER_MASTER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/CYBER" && pwd)"
SCRIPTER_ROOT="$(cd "$CYBER_MASTER_DIR/../../../.." && pwd)"
PYTHON_WRAPPER="$CYBER_MASTER_DIR/common/run_python.sh"
ALIASES="$CYBER_MASTER_DIR/common/aliases.sh"

# shellcheck source=/dev/null
[[ -f "$SCRIPTER_ROOT/.core/ui.sh" ]] && source "$SCRIPTER_ROOT/.core/ui.sh"
source "$ALIASES"

show_help() {
    echo "Cyber-Master: Modular Cybersecurity Toolset"
    echo "=========================================="
    echo "Usage: ./cyber.sh <command> [arguments]"
    echo ""
    echo "Commands:"
    echo "  mail <file>       Run the Phishing Email Analyzer on an .eml file."
    echo "  enrich <target>   Run the Passive DNS & URL Enricher."
    echo "  score             Run the Risk Scorer (requires JSON via stdin)."
    echo "  report [format]   Generate a Markdown, HTML, or PDF report (requires JSON via stdin)."
    echo "  geotrace          Traceroute script with extra information."
    echo "  recon             Reconnaissance script for domain, ip, vendor."
    echo ""
    echo "Pipeline Wrappers:"
    echo "  threatctx <target> [fmt] Run full enrichment, scoring, and reporting (md/html/pdf)."
    echo "  mailreport <file>        Analyze an email and output a Markdown report."
    echo "  mhdr <file>              Extract key findings (IP, SPF, DKIM) from an email."
    echo "  mailtrace <file>         Analyze an email and display the Terminal UI."
    echo ""
    echo "Interactive:"
    echo "  interactive        Start the interactive wizard to guide you through tools."
    echo ""
}

# Colors
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

pause() {
    echo -e "\n${YELLOW}Press Enter to continue...${NC}"
    read -r
}

get_eml_file() {
    read -e -p "Enter path to .eml file or raw headers: " eml_file
    if [ ! -f "$eml_file" ]; then
        echo -e "${RED}File not found: $eml_file${NC}"
        pause
        return 1
    fi
    return 0
}

get_target() {
    read -e -p "Enter target IP or Domain: " target
    if [ -z "$target" ]; then
        echo -e "${RED}Target cannot be empty.${NC}"
        pause
        return 1
    fi
    return 0
}

_cyber_toggle_badge() {
    if [[ "$1" == "true" ]]; then
        printf "${GREEN}[AAN]${NC}"
    else
        printf "${DIM}[UIT]${NC}"
    fi
}

_cyber_prompt_extra_flags() {
    local __var_name="$1"
    local __tool_name="$2"
    local __help_cmd="$3"
    local __current="$4"
    local __examples="$5"

    echo ""
    echo -e "${CYAN}${BOLD}--- Extra CLI-flags voor ${__tool_name} ---${NC}"
    echo "Hier kun je optionele extra command-line flags meegeven die niet als losse schakelaar in het menu staan."
    echo ""
    echo -e "${YELLOW}Beschikbare overige/referentie-vlaggen (${__tool_name} --help):${NC}"
    local __help_lines
    __help_lines="$("$__help_cmd" --help 2>/dev/null | grep -E '^[[:space:]]*(-|--|#?[[:space:]]+--)' | grep -vE '(--max-hops|--wait|--queries|--resolve|--json|--ping|--trace|--ssl|--cloudflare|--confirm|--all|--verbose|--silent|-ip )' | head -n 6 || true)"
    if [[ -n "$__help_lines" ]]; then
        echo "$__help_lines"
    else
        echo "  (Alle standaard-vlaggen staan al als losse schakelaar in het menu; --help blijft beschikbaar.)"
    fi
    echo ""
    echo -e "${GREEN}Voorbeelden:${NC} ${__examples}"
    echo -e "${DIM}Huidige extra flags: ${__current:-geen}${NC}"
    echo ""
    local __val=""
    read -rp "Typ extra flags ('-' of 'clear' = wissen, Enter / '0' = terug): " __val
    case "$__val" in
        ""|0|q|Q)
            return 0
            ;;
        -|clear|CLEAR)
            printf -v "$__var_name" '%s' ""
            return 0
            ;;
        *)
            printf -v "$__var_name" '%s' "$__val"
            return 0
            ;;
    esac
}

configure_and_run_geotrace() {
    local target="${1:-}"
    local max_hops="30"
    local wait_sec="2"
    local queries="1"
    local do_resolve="false"
    local output_json="false"
    local extra_flags=""

    while true; do
        local -a cmd_args=("-m" "$max_hops" "-w" "$wait_sec" "-q" "$queries")
        [[ "$do_resolve" == "true" ]] && cmd_args+=("--resolve")
        [[ "$output_json" == "true" ]] && cmd_args+=("--json")
        if [[ -n "$extra_flags" ]]; then
            # shellcheck disable=SC2206
            cmd_args+=($extra_flags)
        fi
        local target_disp="${target:-<niet ingesteld>}"
        local cmd_preview="geotrace ${cmd_args[*]} ${target:-<target>}"

        ui_clear_screen
        local -a header_lines=(
            "Target   : ${CYAN}${target_disp}${NC}"
            "Opties   : Hops=${CYAN}${max_hops}${NC} | Wait=${CYAN}${wait_sec}s${NC} | Queries=${CYAN}${queries}${NC} | DNS=$(_cyber_toggle_badge "$do_resolve") | JSON=$(_cyber_toggle_badge "$output_json")"
        )
        [[ -n "$extra_flags" ]] && header_lines+=("Extra    : ${CYAN}${extra_flags}${NC}")
        header_lines+=("Commando : ${DIM}${cmd_preview}${NC}")
        ui_header "GEOTRACE — CONFIGURATIE & START" "${header_lines[@]}"

        ui_item "1" "Uitvoeren / Starten (Run)"    "Start geotrace met bovenstaande opties"
        ui_item "2" "Target / Doelwit instellen"   "IP, domein of host (${target_disp})"
        ui_item "3" "Max hops (-m)"                "Maximaal aantal hops (huidige: ${max_hops})"
        ui_item "4" "Timeout per hop (-w)"         "Wachttijd in seconden (huidige: ${wait_sec}s)"
        ui_item "5" "Probes per hop (-q)"          "Aantal queries per hop (huidige: ${queries})"
        ui_item "6" "Reverse-DNS (--resolve)"      "$(_cyber_toggle_badge "$do_resolve") Toon hostnames per hop"
        ui_item "7" "JSON output (--json)"         "$(_cyber_toggle_badge "$output_json") Output als JSON"
        ui_item "8" "Extra CLI-flags"              "(optioneel — handmatige vlaggen toevoegen, bijv. --help; nu: ${extra_flags:-geen})"
        ui_item "R" "Reset naar standaardwaarden"  "Herstel alle opties naar defaults"
        ui_item "0" "Terug (Annuleren)"            ""
        printf "\n"

        local sub_choice=""
        ui_read_menu_choice sub_choice "Keuze"
        case "$sub_choice" in
            1)
                if [[ -z "$target" ]]; then
                    if ! ui_prompt_input target "Target IP, domein of host"; then
                        continue
                    fi
                fi
                local -a run_args=("-m" "$max_hops" "-w" "$wait_sec" "-q" "$queries")
                [[ "$do_resolve" == "true" ]] && run_args+=("--resolve")
                [[ "$output_json" == "true" ]] && run_args+=("--json")
                if [[ -n "$extra_flags" ]]; then
                    # shellcheck disable=SC2206
                    run_args+=($extra_flags)
                fi
                run_args+=("$target")
                ui_run_safe "geotrace $target" "$CYBER_MASTER_DIR/geotrace" "${run_args[@]}"
                ;;
            2)
                local new_target=""
                if ui_prompt_input new_target "Target IP, domein of host" "$target"; then
                    target="$new_target"
                fi
                ;;
            3)
                local new_hops=""
                if ui_prompt_input new_hops "Max hops (1-255)" "$max_hops"; then
                    if [[ "$new_hops" =~ ^[0-9]+$ ]] && [[ "$new_hops" -ge 1 && "$new_hops" -le 255 ]]; then
                        max_hops="$new_hops"
                    else
                        ui_warn "Ongeldig aantal hops: '$new_hops'"
                        ui_pause
                    fi
                fi
                ;;
            4)
                local new_wait=""
                if ui_prompt_input new_wait "Timeout in seconden (1-30)" "$wait_sec"; then
                    if [[ "$new_wait" =~ ^[0-9]+$ ]] && [[ "$new_wait" -ge 1 && "$new_wait" -le 30 ]]; then
                        wait_sec="$new_wait"
                    else
                        ui_warn "Ongeldige timeout: '$new_wait'"
                        ui_pause
                    fi
                fi
                ;;
            5)
                local new_q=""
                if ui_prompt_input new_q "Probes per hop (1-10)" "$queries"; then
                    if [[ "$new_q" =~ ^[0-9]+$ ]] && [[ "$new_q" -ge 1 && "$new_q" -le 10 ]]; then
                        queries="$new_q"
                    else
                        ui_warn "Ongeldig aantal probes: '$new_q'"
                        ui_pause
                    fi
                fi
                ;;
            6)
                [[ "$do_resolve" == "true" ]] && do_resolve="false" || do_resolve="true"
                ;;
            7)
                [[ "$output_json" == "true" ]] && output_json="false" || output_json="true"
                ;;
            8)
                _cyber_prompt_extra_flags extra_flags "geotrace" "$CYBER_MASTER_DIR/geotrace" "$extra_flags" "--help  |  -m 15 -w 1  |  --resolve --json"
                ;;
            [rR])
                max_hops="30"; wait_sec="2"; queries="1"
                do_resolve="false"; output_json="false"; extra_flags=""
                ;;
            0|q|Q)
                return 0
                ;;
            *)
                ui_warn "Ongeldige keuze."
                ui_pause
                ;;
        esac
    done
}

configure_and_run_recon() {
    local target="${1:-}"
    local mode="domain"
    local do_ping="false"
    local do_trace="false"
    local do_ssl="false"
    local do_cloudflare="false"
    local do_confirm="false"
    local output_lvl="normal"
    local extra_flags=""

    while true; do
        local -a cmd_args=()
        [[ "$mode" == "ip" ]] && cmd_args+=("-ip")
        [[ "$do_ping" == "true" ]] && cmd_args+=("--ping")
        [[ "$do_trace" == "true" ]] && cmd_args+=("--trace")
        [[ "$do_ssl" == "true" ]] && cmd_args+=("--ssl")
        [[ "$do_cloudflare" == "true" ]] && cmd_args+=("--cloudflare")
        [[ "$do_confirm" == "true" ]] && cmd_args+=("--confirm")
        [[ "$output_lvl" == "verbose" ]] && cmd_args+=("--verbose")
        [[ "$output_lvl" == "silent" ]] && cmd_args+=("--silent")
        if [[ -n "$extra_flags" ]]; then
            # shellcheck disable=SC2206
            cmd_args+=($extra_flags)
        fi
        if [[ "$mode" == "vendor" ]]; then
            cmd_args+=("--vendor" "${target:-<bedrijf>}")
        else
            cmd_args+=("${target:-<target>}")
        fi

        local target_disp="${target:-<niet ingesteld>}"
        local cmd_preview="recon ${cmd_args[*]}"

        ui_clear_screen
        local -a recon_header_lines=(
            "Target   : ${CYAN}${target_disp}${NC} | Type: ${CYAN}${mode}${NC} | Output: ${CYAN}${output_lvl}${NC}"
            "Features : Ping=$(_cyber_toggle_badge "$do_ping") Trace=$(_cyber_toggle_badge "$do_trace") SSL=$(_cyber_toggle_badge "$do_ssl") CF=$(_cyber_toggle_badge "$do_cloudflare") Confirm=$(_cyber_toggle_badge "$do_confirm")"
        )
        [[ -n "$extra_flags" ]] && recon_header_lines+=("Extra    : ${CYAN}${extra_flags}${NC}")
        recon_header_lines+=("Commando : ${DIM}${cmd_preview}${NC}")
        ui_header "RECON — CONFIGURATIE & START" "${recon_header_lines[@]}"

        ui_item "1"  "Uitvoeren / Starten (Run)"      "Start recon met bovenstaande opties"
        ui_item "2"  "Target / Doelwit instellen"     "Domein, IP of bedrijfsnaam (${target_disp})"
        ui_item "3"  "Doeltype wisselen"              "domain -> -ip -> --vendor (huidige: ${mode})"
        ui_item "4"  "Ping test (--ping)"             "$(_cyber_toggle_badge "$do_ping") ICMP bereikbaarheidstest"
        ui_item "5"  "Traceroute (--trace)"           "$(_cyber_toggle_badge "$do_trace") Pad-analyse (30s timeout)"
        ui_item "6"  "SSL analyse (--ssl)"            "$(_cyber_toggle_badge "$do_ssl") Certificaat & TLS inspectie"
        ui_item "7"  "CloudFlare check (--cloudflare)" "$(_cyber_toggle_badge "$do_cloudflare") CDN/WAF detectie"
        ui_item "8"  "Vendor confirm (--confirm)"     "$(_cyber_toggle_badge "$do_confirm") Eerste gevonden domein kiezen"
        ui_item "9"  "Alles activeren (--all)"        "Zet Ping, Trace, SSL en CloudFlare AAN"
        ui_item "10" "Output-niveau wisselen"         "normaal -> verbose -> silent (huidige: ${output_lvl})"
        ui_item "11" "Extra CLI-flags"                "(optioneel — handmatige vlaggen toevoegen, bijv. --help; nu: ${extra_flags:-geen})"
        ui_item "R"  "Reset naar standaardwaarden"    "Herstel alle opties naar defaults"
        ui_item "0"  "Terug (Annuleren)"              ""
        printf "\n"

        local sub_choice=""
        ui_read_menu_choice sub_choice "Keuze"
        case "$sub_choice" in
            1)
                if [[ -z "$target" ]]; then
                    if ! ui_prompt_input target "Target (domein, IP of vendor)"; then
                        continue
                    fi
                fi
                local -a run_args=()
                [[ "$mode" == "ip" ]] && run_args+=("-ip")
                [[ "$do_ping" == "true" ]] && run_args+=("--ping")
                [[ "$do_trace" == "true" ]] && run_args+=("--trace")
                [[ "$do_ssl" == "true" ]] && run_args+=("--ssl")
                [[ "$do_cloudflare" == "true" ]] && run_args+=("--cloudflare")
                [[ "$do_confirm" == "true" ]] && run_args+=("--confirm")
                [[ "$output_lvl" == "verbose" ]] && run_args+=("--verbose")
                [[ "$output_lvl" == "silent" ]] && run_args+=("--silent")
                if [[ -n "$extra_flags" ]]; then
                    # shellcheck disable=SC2206
                    run_args+=($extra_flags)
                fi
                if [[ "$mode" == "vendor" ]]; then
                    run_args+=("--vendor" "$target")
                else
                    run_args+=("$target")
                fi
                ui_run_safe "recon $target" "$CYBER_MASTER_DIR/recon" "${run_args[@]}"
                ;;
            2)
                local new_target=""
                if ui_prompt_input new_target "Target (domein, IP of vendor)" "$target"; then
                    target="$new_target"
                fi
                ;;
            3)
                case "$mode" in
                    domain) mode="ip" ;;
                    ip)     mode="vendor" ;;
                    *)      mode="domain" ;;
                esac
                ;;
            4) [[ "$do_ping" == "true" ]] && do_ping="false" || do_ping="true" ;;
            5) [[ "$do_trace" == "true" ]] && do_trace="false" || do_trace="true" ;;
            6) [[ "$do_ssl" == "true" ]] && do_ssl="false" || do_ssl="true" ;;
            7) [[ "$do_cloudflare" == "true" ]] && do_cloudflare="false" || do_cloudflare="true" ;;
            8) [[ "$do_confirm" == "true" ]] && do_confirm="false" || do_confirm="true" ;;
            9)
                do_ping="true"; do_trace="true"; do_ssl="true"; do_cloudflare="true"
                ;;
            10)
                case "$output_lvl" in
                    normal)  output_lvl="verbose" ;;
                    verbose) output_lvl="silent" ;;
                    *)       output_lvl="normal" ;;
                esac
                ;;
            11)
                _cyber_prompt_extra_flags extra_flags "recon" "$CYBER_MASTER_DIR/recon" "$extra_flags" "--help  |  --all --verbose  |  --vendor \"Microsoft\" --confirm"
                ;;
            [rR])
                mode="domain"; do_ping="false"; do_trace="false"; do_ssl="false"
                do_cloudflare="false"; do_confirm="false"; output_lvl="normal"; extra_flags=""
                ;;
            0|q|Q)
                return 0
                ;;
            *)
                ui_warn "Ongeldige keuze."
                ui_pause
                ;;
        esac
    done
}

run_interactive() {
    while true; do
        clear
        echo -e "${CYAN}================================================${NC}"
        echo -e "         ${CYAN}CYBER-MASTER CONTROL PANEL${NC}"
        echo -e "${CYAN}================================================${NC}"
        echo -e "${GREEN}--- Email / Phishing Analysis ---${NC}"
        echo "1) Analyze Email (mailtrace)"
        echo "2) Extract Key Findings from Email (mhdr)"
        echo -e "\n${GREEN}--- Recon & Threat Context ---${NC}"
        echo "3) Recon Domain/IP and Generate Markdown Report"
        echo "4) Recon Domain/IP and Generate HTML Report"
        echo "5) Recon Domain/IP and Generate PDF Report"
        echo "6) Run geotrace"
        echo "7) Run recon"
        echo "8) Email Analysis Markdown Report (.eml)"
        echo -e "\n${YELLOW}0) Terug${NC}"
        echo -e "${CYAN}================================================${NC}"

        local choice=""
        ui_read_menu_choice choice "Select action"

        case "$choice" in
            1)
                if get_eml_file; then mailtrace "$eml_file"; pause; fi
                ;;
            2)
                if get_eml_file; then cat "$eml_file" | mhdr; pause; fi
                ;;
            3)
                if get_target; then threatctx "$target" md; pause; fi
                ;;
            4)
                if get_target; then threatctx "$target" html; pause; fi
                ;;
            5)
                if get_target; then threatctx "$target" pdf; pause; fi
                ;;
            6)
                configure_and_run_geotrace
                ;;
            7)
                configure_and_run_recon
                ;;
            8)
                if get_eml_file; then mailreport "$eml_file"; pause; fi
                ;;
            0|[xX]|[qQ])
                echo -e "${GREEN}Exiting...${NC}"
                clear
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid choice.${NC}"
                pause
                ;;
        esac
    done
}

# Default to interactive if no arguments
COMMAND=${1:-interactive}
if [ $# -gt 0 ]; then
    shift
fi

case "$COMMAND" in
    mail)
        "$PYTHON_WRAPPER" "$CYBER_MASTER_DIR/mail/mail_analyzer.py" "$@"
        ;;
    enrich)
        "$PYTHON_WRAPPER" "$CYBER_MASTER_DIR/enrich/enricher.py" "$@"
        ;;
    score)
        "$PYTHON_WRAPPER" "$CYBER_MASTER_DIR/scoring/risk_scorer.py" "$@"
        ;;
    report)
        if [[ $# -eq 0 || ( "${1:-}" == "--format" && "${2:-}" == "md" && -z "${3:-}" ) ]]; then
            tmp_rep_in="$(mktemp "${TMPDIR:-/tmp}/cyber_report_in.XXXXXX")"
            cat > "$tmp_rep_in"
            cyber_output_report "$tmp_rep_in" "report" "md"
            rc=$?
            rm -f "$tmp_rep_in" 2>/dev/null || true
            exit $rc
        else
            "$PYTHON_WRAPPER" "$CYBER_MASTER_DIR/reporting/reporter.py" "$@"
        fi
        ;;
    geotrace)
        if [[ $# -eq 0 ]]; then
            configure_and_run_geotrace
        else
            "$CYBER_MASTER_DIR/geotrace" "$@"
        fi
        ;;
    recon)
        if [[ $# -eq 0 ]]; then
            configure_and_run_recon
        else
            "$CYBER_MASTER_DIR/recon" "$@"
        fi
        ;;
    threatctx)
        threatctx "$@"
        ;;
    mailreport)
        mailreport "$@"
        ;;
    mhdr)
        if [ -n "$1" ] && [ -f "$1" ]; then
            cat "$1" | mhdr
        else
            mhdr
        fi
        ;;
    mailtrace)
        mailtrace "$@"
        ;;
    interactive)
        run_interactive
        ;;
    --help|-h|help)
        show_help
        ;;
    *)
        echo "Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac
