#!/usr/bin/env bash
# ./scripter - Unified Cross-Platform Hub & CLI Router

set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT_DIR/.core/os_detect.sh"
source "$ROOT_DIR/.core/ui.sh"
source "$ROOT_DIR/.core/deps.sh"
source "$ROOT_DIR/.core/persist.sh"

_startup_precheck() {
    # Silently ensure executable permissions on core & module scripts
    [[ -x "$ROOT_DIR/scripter" ]] || chmod +x "$ROOT_DIR/scripter" 2>/dev/null || true
    chmod +x "$ROOT_DIR/.core/"*.sh 2>/dev/null || true
    if [[ -d "$ROOT_DIR/modules" ]]; then
        find "$ROOT_DIR/modules" -type f \( -name "*.sh" -o -name "*.py" \) ! -perm -u+x -exec chmod +x {} + 2>/dev/null || true
    fi
    # Initialize .config/.env from .config/.env.example if missing
    mkdir -p "$ROOT_DIR/.config" "$ROOT_DIR/.dep" 2>/dev/null || true
    if [[ ! -f "$ROOT_DIR/.config/.env" && -f "$ROOT_DIR/.config/.env.example" ]]; then
        cp "$ROOT_DIR/.config/.env.example" "$ROOT_DIR/.config/.env" 2>/dev/null || true
    fi
    # Silently initialize .dep/.venv if python3 is available and venv is missing
    if [[ ! -d "$ROOT_DIR/.dep/.venv" ]] && command -v python3 >/dev/null 2>&1; then
        python3 -m venv "$ROOT_DIR/.dep/.venv" >/dev/null 2>&1 || true
    fi
}
_startup_precheck

SHOW_ALL="false"
FORCE_RUN="false"

_os_display() {
    case "$OS_TYPE" in
        macOS) echo "macOS (Darwin)" ;;
        QNAP)  echo "QNAP NAS (Linux)" ;;
        Linux) echo "Linux ($(uname -r 2>/dev/null || echo kernel))" ;;
        *)     echo "Unknown" ;;
    esac
}

show_help() {
    ui_header "SCRIPTER HUB - CLI REFERENCE" "System : ${CYAN}$(_os_display)${NC} | Arch: ${CYAN}${ARCH}${NC} | PkgMgr: ${CYAN}${PKG_MGR}${NC}"
    printf "\n%bUSAGE:%b\n" "${YELLOW}${BOLD}" "${NC}"
    printf "  ./scripter                      Launch interactive TUI menu\n"
    printf "  ./scripter +<module> [args...]    Direct module routing (+ or -- prefix)\n"
    printf "  ./scripter --persist              Configure OS-specific shell persistence\n"
    printf "  ./scripter -h | --help            Show this help message\n"

    printf "\n%bAVAILABLE +SWITCHES & SHORTCODES:%b\n" "${YELLOW}${BOLD}" "${NC}"
    printf "  %bDEVELOPMENT & OPS:%b\n" "${CYAN}" "${NC}"
    printf "    +gitmaster, +git, -g          [UNI] Git Workflow Manager\n"
    printf "    +containermaster, +docker, -c [UNI] Docker / Container Manager\n"
    printf "    +dbmaster, +db, -b            [UNI] Database Tools\n"
    printf "    +webmaster, +web, -w          [UNI] Web Scaffold Tools\n"

    if [[ "$OS_TYPE" == "macOS" || "$OS_TYPE" == "QNAP" || "$SHOW_ALL" == "true" ]]; then
        printf "  %bSYSTEEMBEHEER:%b\n" "${CYAN}" "${NC}"
        [[ "$OS_TYPE" == "macOS" || "$SHOW_ALL" == "true" ]] && printf "    +macmaster, +mac, -m          [MAC] macOS System Maintenance\n"
        [[ "$OS_TYPE" == "QNAP"  || "$SHOW_ALL" == "true" ]] && printf "    +qnapmaster, +qnap, -q        [QNAP] Container, Share & Entware\n"
    fi

    printf "  %bBESTANDS- & DATABEHEER:%b\n" "${CYAN}" "${NC}"
    printf "    +filemaster, +file, -f        [UNI] File Management Tools\n"
    printf "    +datamaster, +data, -a        [UNI] Data Processing Tools\n"
    printf "    +textmaster, +text, -t        [UNI] Text Processing Tools\n"
    [[ "$OS_TYPE" == "macOS" || "$SHOW_ALL" == "true" ]] && printf "    +rename_ebooks, +ebooks, -e   [MAC] E-book Metadata Renamer\n"

    if [[ "$OS_TYPE" == "macOS" || "$SHOW_ALL" == "true" ]]; then
        printf "  %bNETWERK & CYBERSECURITY:%b\n" "${CYAN}" "${NC}"
        printf "    +networkmaster, +net, -n      [MAC] Network Scanner & Tools\n"
        printf "    +cybermaster, +cyber, -y      [MAC] Cybersecurity & Recon\n"
        printf "    +intelmaster, +intel, -i      [MAC] Threat Intelligence\n"
        printf "  %bMEDIA & MULTIMEDIA:%b\n" "${CYAN}" "${NC}"
        printf "    +audiomaster, +audio, -u      [MAC] Audio Processing & Tagging\n"
        printf "    +videomaster, +video, -v      [MAC] Video Processing\n"
        printf "    +imagemaster, +img, -p        [MAC] Image Batch Processing\n"
        printf "    +karaokemaster, +karaoke, -k  [MAC] Karaoke & CDG Tools\n"
    fi

    printf "  %bUTILITIES & ONDERHOUD:%b\n" "${YELLOW}" "${NC}"
    printf "    +deps [status|install|update]       Dependency & Update Center\n"
    printf "    --persist                           Make scripter persistent on this OS\n"
    printf "\n  %bVoorbeelden:%b ./scripter -g status | ./scripter -c ls | ./scripter -f rename --help\n" "${DIM}" "${NC}"
    if [[ "$SHOW_ALL" == "false" ]]; then
        printf "  %bTip: gebruik 'scripter --all' om alle platformmodules te tonen.%b\n" "${DIM}" "${NC}"
    fi
    printf "\n"
}

_run_tool() {
    local path="$1"
    shift || true
    if [[ -x "$path" ]]; then
        "$path" "$@"
    elif [[ -f "$path" ]]; then
        bash "$path" "$@"
    else
        ui_warn "Module not installed at: $path"
        return 1
    fi
}

_resolve_common() {
    local name="$1"
    shift || true
    local candidates=(
        "$ROOT_DIR/modules/common/$name/${name}master.sh"
        "$ROOT_DIR/modules/common/$name/$name.sh"
        "$ROOT_DIR/modules/common/$name.sh"
    )
    local c
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then
            _run_tool "$c" "$@"
            return $?
        fi
    done
    ui_warn "Universal module '$name' is not yet migrated into modules/common/."
    return 1
}

route_module() {
    local raw="$1"
    shift || true
    local mod="${raw#+}"
    mod="${mod#--}"
    mod="${mod#-}"

    case "$mod" in
        deps|dep)
            case "${1:-status}" in
                status|check) deps_status ;;
                install)      deps_install_missing ;;
                update)       deps_update_all ;;
                menu)         deps_menu ;;
                *)            ui_err "Usage: scripter +deps {status|install|update|menu}"; exit 1 ;;
            esac
            ;;
        gitmaster|git|g)               _resolve_common "git" "$@" ;;
        containermaster|container|docker|cnt|c) _resolve_common "container" "$@" ;;
        dbmaster|db|b)                 _resolve_common "db" "$@" ;;
        datamaster|data|a)             _resolve_common "data" "$@" ;;
        textmaster|text|t)             _resolve_common "text" "$@" ;;
        filemaster|file|f)             _resolve_common "file" "$@" ;;
        webmaster|web|w)               _resolve_common "web" "$@" ;;
        macmaster|macsystem|mac|m)
            if [[ -z "${1:-}" ]]; then
                _run_tool "$ROOT_DIR/modules/macos/macsystem/macmanager.sh"
            elif [[ "${1:-}" == "aliases" || "${1:-}" == "alias" ]]; then
                source "$ROOT_DIR/.core/aliases.sh"
                alias_manager_menu
            else
                local sub="$1"; shift
                _run_tool "$ROOT_DIR/modules/macos/macsystem/${sub%.sh}.sh" "$@"
            fi
            ;;
        networkmaster|net|n)           _run_tool "$ROOT_DIR/modules/macos/security/networkmaster" "$@" ;;
        cybermaster|cyber|y)           _run_tool "$ROOT_DIR/modules/macos/security/cybermaster" "$@" ;;
        intelmaster|intel|i)           _run_tool "$ROOT_DIR/modules/macos/security/intelmaster" "$@" ;;
        audiomaster|audio|u)           _run_tool "$ROOT_DIR/modules/macos/media/audiomaster" "$@" ;;
        videomaster|video|v)           _run_tool "$ROOT_DIR/modules/macos/media/videomaster" "$@" ;;
        imagemaster|image|img|p)       _run_tool "$ROOT_DIR/modules/macos/media/imagemaster" "$@" ;;
        karaokemaster|karaoke|k)       _run_tool "$ROOT_DIR/modules/macos/media/karaokemaster" "$@" ;;
        rename_ebooks|ebooks|e)        _run_tool "$ROOT_DIR/modules/macos/media/rename_ebooks" "$@" ;;
        qnap|qnapmaster|q)
            if [[ "$OS_TYPE" != "QNAP" && "$FORCE_RUN" != "true" ]]; then
                ui_warn "Module 'qnapmaster' is alleen beschikbaar op QNAP/Linux (huidig OS: $OS_TYPE). Gebruik --force om toch uit te voeren."
                return 1
            fi
            _run_tool "$ROOT_DIR/modules/qnap/qnapmaster.sh" "$@"
            ;;
        *)
            ui_err "Unknown module/switch: '$raw'. Run './scripter --help' for available +switches."
            exit 1
            ;;
    esac
}

_is_visible() {
    local req_os="$1"
    [[ "$SHOW_ALL" == "true" || "$req_os" == "UNI" ]] && return 0
    [[ "$req_os" == "MAC" && "$OS_TYPE" == "macOS" ]] && return 0
    [[ "$req_os" == "QNAP" && "$OS_TYPE" == "QNAP" ]] && return 0
    return 1
}

interactive_menu() {
    while true; do
        ui_clear_screen
        ui_header "SCRIPTER CONTROL PANEL" \
            "System : ${CYAN}$(_os_display)${NC} | Arch: ${CYAN}${ARCH}${NC}" \
            "PkgMgr : ${CYAN}${PKG_MGR}${NC} | Root: ${CYAN}${IS_ROOT}${NC}"

        local cat_idx=1
        local item_idx=1
        local MENU_TARGETS=()

        _render_cat() {
            local title="$1"; shift
            local visible=()
            local entry req mod desc
            for entry in "$@"; do
                IFS='|' read -r req mod desc <<< "$entry"
                _is_visible "$req" && visible+=("$entry")
            done
            [[ ${#visible[@]} -eq 0 ]] && return 0
            ui_section "${cat_idx}. ${title}"
            ((cat_idx++))
            for entry in "${visible[@]}"; do
                IFS='|' read -r req mod desc <<< "$entry"
                ui_item "$item_idx" "$mod [$req]" "$desc"
                MENU_TARGETS+=("+$mod")
                ((item_idx++))
            done
        }

        _render_cat "DEVELOPMENT & OPS" \
            "UNI|gitmaster|Git workflow manager" \
            "UNI|containermaster|Docker & container tools" \
            "UNI|dbmaster|Database utilities" \
            "UNI|webmaster|Web project scaffold"

        _render_cat "SYSTEEMBEHEER" \
            "MAC|macmaster|System, crontab, zshrc, cleanup" \
            "QNAP|qnapmaster|Container Station, @Recycle, Entware"

        _render_cat "BESTANDS- & DATABEHEER" \
            "UNI|filemaster|File & batch rename tools" \
            "UNI|datamaster|Data & CSV/JSON/YAML tools" \
            "UNI|textmaster|Text & log utilities" \
            "MAC|rename_ebooks|E-book metadata renamer"

        _render_cat "NETWERK & CYBERSECURITY" \
            "MAC|networkmaster|Network scanner & geotrace" \
            "MAC|cybermaster|Recon, mail & risk scoring" \
            "MAC|intelmaster|Threat intelligence analyzer"

        _render_cat "MEDIA & MULTIMEDIA" \
            "MAC|audiomaster|Audio conversion & MP3 tags" \
            "MAC|videomaster|Video conversion & A/V tools" \
            "MAC|imagemaster|Image batch & EXIF tools" \
            "MAC|karaokemaster|CDG & karaoke organizer"

        ui_section "${cat_idx}. UTILITIES & ONDERHOUD"
        ui_item "P" "Make Persistent"   "Configure shell alias/PATH for $OS_TYPE"
        ui_item "D" "Dependency Center" "Check, install or update tools"
        ui_item "H" "Help & CLI"        "Show available +switches"
        ui_item "0" "Afsluiten (Exit)"  ""

        printf "\n"
        local choice=""
        ui_read_menu_choice choice "Select option"
        case "$choice" in
            d|D) deps_menu ;;
            p|P)
                persist_system
                printf "\n"
                read -rp "Press [Enter] to return to menu..." _
                ;;
            h|H)
                ui_clear_screen
                show_help
                read -rp "Press [Enter] to return to menu..." _
                ;;
            0|q|Q|exit) exit 0 ;;
            *)
                if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 && "$choice" -le ${#MENU_TARGETS[@]} ]]; then
                    local target_mod="${MENU_TARGETS[$((choice-1))]}"
                    if ! route_module "$target_mod"; then
                        ui_err "Module '$target_mod' eindigde met een fout."
                        ui_pause
                    fi
                else
                    ui_warn "Invalid option: $choice"
                    ui_pause
                fi
                ;;
        esac
    done
}

# --- CLI ENTRYPOINT ---
ARGS=()
SHOW_HELP="false"
for arg in "$@"; do
    case "$arg" in
        --all) SHOW_ALL="true" ;;
        --force) FORCE_RUN="true" ;;
        -h|--help) SHOW_HELP="true" ;;
        *) ARGS+=("$arg") ;;
    esac
done

if [[ "$SHOW_HELP" == "true" ]]; then
    show_help
    exit 0
fi

if [[ ${#ARGS[@]} -eq 0 ]]; then
    interactive_menu
fi

case "${ARGS[0]}" in
    --persist)
        persist_system
        exit 0
        ;;
    +*|--*|-*)
        route_module "${ARGS[@]}"
        ;;
    *)
        route_module "+${ARGS[0]}" "${ARGS[@]:1}"
        ;;
esac
