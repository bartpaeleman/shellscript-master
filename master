#!/usr/bin/env bash
# ./master - Smart Central Hub for cross-platform shellscripts

set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT_DIR/.core/os_detect.sh"
source "$ROOT_DIR/.core/deps.sh"

SHOW_ALL="false"

show_help() {
    cat <<EOF
Master Hub - Unified CLI & Interactive Hub ($OS_TYPE / $ARCH)

Usage:
  ./master [flags]                  Launch interactive menu
  ./master <module> [args...]       Direct CLI routing

Flags:
  --all                             Show all modules regardless of OS
  -h, --help                        Show this help message

Direct Routing Examples:
  ./master deps status              Check all binary & Python dependencies
  ./master deps install             Install missing dependencies
  ./master deps update              Update all tools & packages
  ./master macsystem                Launch macOS system maintenance
  ./master security networkmaster   Run networkmaster
  ./master media audiomaster        Run audiomaster
  ./master qnap containers          Show QNAP Container Station status
  ./master <common-mod> [args...]   Route to modules/common/<common-mod>
EOF
}

_run_tool() {
    local path="$1"
    shift
    if [[ -x "$path" ]]; then
        "$path" "$@"
    elif [[ -f "$path" ]]; then
        bash "$path" "$@"
    else
        echo "Tool not found: $path"
        return 1
    fi
}

route_cli() {
    local cmd="$1"
    shift || true

    case "$cmd" in
        deps|dep)
            case "${1:-status}" in
                status|check) deps_status ;;
                install)      deps_install_missing ;;
                update)       deps_update_all ;;
                menu)         deps_menu ;;
                *)            echo "Usage: ./master deps {status|install|update|menu}" ; exit 1 ;;
            esac
            ;;
        macsystem|mac)
            if [[ -z "${1:-}" ]]; then
                _run_tool "$ROOT_DIR/modules/macos/macsystem/macmanager.sh"
            else
                local sub="$1"; shift
                local target="$ROOT_DIR/modules/macos/macsystem/${sub%.sh}.sh"
                _run_tool "$target" "$@"
            fi
            ;;
        security|sec)
            if [[ -z "${1:-}" ]]; then
                echo "Available security tools: networkmaster, cybermaster, intelmaster"
                exit 1
            fi
            local sub="$1"; shift
            _run_tool "$ROOT_DIR/modules/macos/security/$sub" "$@"
            ;;
        media)
            if [[ -z "${1:-}" ]]; then
                echo "Available media tools: audiomaster, videomaster, imagemaster, karaokemaster, rename_ebooks"
                exit 1
            fi
            local sub="$1"; shift
            _run_tool "$ROOT_DIR/modules/macos/media/$sub" "$@"
            ;;
        qnap)
            _run_tool "$ROOT_DIR/modules/qnap/qnapmaster.sh" "$@"
            ;;
        *)
            # Check modules/common/<cmd>
            if [[ -d "$ROOT_DIR/modules/common/$cmd" ]]; then
                local entry="$ROOT_DIR/modules/common/$cmd/${cmd}master.sh"
                [[ ! -f "$entry" ]] && entry="$ROOT_DIR/modules/common/$cmd/$cmd.sh"
                _run_tool "$entry" "$@"
            elif [[ -f "$ROOT_DIR/modules/common/$cmd.sh" ]]; then
                _run_tool "$ROOT_DIR/modules/common/$cmd.sh" "$@"
            else
                echo "Unknown module or command: '$cmd'. Run './master --help' for usage."
                exit 1
            fi
            ;;
    esac
}

menu_macos() {
    while true; do
        echo ""
        echo "=== macOS Modules ==="
        echo "1) macsystem  (crontab, zshrc, cleanup, cache, uninstall)"
        echo "2) security   (networkmaster, cybermaster, intelmaster)"
        echo "3) media      (audio, video, image, karaoke, ebooks)"
        echo "0) Back"
        read -rp "Choice: " c
        case "$c" in
            1) _run_tool "$ROOT_DIR/modules/macos/macsystem/macmanager.sh" ;;
            2)
                echo "Tools: 1) networkmaster  2) cybermaster  3) intelmaster"
                read -rp "Select: " s
                case "$s" in
                    1) _run_tool "$ROOT_DIR/modules/macos/security/networkmaster" ;;
                    2) _run_tool "$ROOT_DIR/modules/macos/security/cybermaster" ;;
                    3) _run_tool "$ROOT_DIR/modules/macos/security/intelmaster" ;;
                esac
                ;;
            3)
                echo "Tools: 1) audiomaster  2) videomaster  3) imagemaster  4) karaokemaster  5) rename_ebooks"
                read -rp "Select: " m
                case "$m" in
                    1) _run_tool "$ROOT_DIR/modules/macos/media/audiomaster" ;;
                    2) _run_tool "$ROOT_DIR/modules/macos/media/videomaster" ;;
                    3) _run_tool "$ROOT_DIR/modules/macos/media/imagemaster" ;;
                    4) _run_tool "$ROOT_DIR/modules/macos/media/karaokemaster" ;;
                    5) _run_tool "$ROOT_DIR/modules/macos/media/rename_ebooks" ;;
                esac
                ;;
            0|q|Q) break ;;
        esac
    done
}

interactive_menu() {
    while true; do
        echo ""
        echo "=========================================="
        echo "  Master Hub | OS: $OS_TYPE ($ARCH) | PKG: $PKG_MGR"
        echo "=========================================="
        if [[ "$OS_TYPE" == "macOS" || "$SHOW_ALL" == "true" ]]; then
            echo "  [M] macOS Modules (macsystem, security, media)"
        fi
        if [[ "$OS_TYPE" == "QNAP" || "$SHOW_ALL" == "true" ]]; then
            echo "  [Q] QNAP Modules  (containers, shares, entware)"
        fi
        if [[ -d "$ROOT_DIR/modules/common" ]] && [[ -n "$(ls -A "$ROOT_DIR/modules/common" 2>/dev/null)" ]]; then
            echo "  [C] Common Modules"
        fi
        echo "  [D] Dependency & Update Center"
        if [[ "$SHOW_ALL" == "false" ]]; then
            echo "  [A] Show all platform modules (--all)"
        fi
        echo "  [0] Exit"
        echo ""
        read -rp "Select option: " choice
        case "$choice" in
            m|M)
                if [[ "$OS_TYPE" == "macOS" || "$SHOW_ALL" == "true" ]]; then
                    menu_macos
                else
                    echo "macOS modules hidden on $OS_TYPE (use --all)."
                fi
                ;;
            q|Q)
                if [[ "$OS_TYPE" == "QNAP" || "$SHOW_ALL" == "true" ]]; then
                    _run_tool "$ROOT_DIR/modules/qnap/qnapmaster.sh" menu
                else
                    echo "QNAP modules hidden on $OS_TYPE (use --all)."
                fi
                ;;
            d|D) deps_menu ;;
            a|A) SHOW_ALL="true" ;;
            0|exit) exit 0 ;;
            *) echo "Invalid option." ;;
        esac
    done
}

# Parse global flags
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --all) SHOW_ALL="true" ;;
        -h|--help) show_help; exit 0 ;;
        *) ARGS+=("$arg") ;;
    esac
done

if [[ ${#ARGS[@]} -gt 0 ]]; then
    route_cli "${ARGS[@]}"
else
    interactive_menu
fi
